# ─────────────────────────────────────────────────────────────
# SabPaisa Payment Gateway credentials
# Copy this file to `.env.local` and fill in the values from your
# SabPaisa onboarding / integration kit. DO NOT commit `.env.local`.
#
# ⚠️  The exact names, the gateway URL, and the encryption key/IV
#     lengths differ between SabPaisa integration versions. Verify
#     every value below against the kit SabPaisa gave you.
# ─────────────────────────────────────────────────────────────

# Merchant identity
SABPAISA_CLIENT_CODE=
SABPAISA_USERNAME=
SABPAISA_PASSWORD=

# AES encryption material (used to encrypt the request / decrypt the
# response). Key length determines the cipher: 16 bytes -> AES-128,
# 24 -> AES-192, 32 -> AES-256. IV is 16 bytes.
SABPAISA_AUTH_KEY=
SABPAISA_AUTH_IV=

# Gateway endpoint.
#   UAT / staging : https://stage-securepay.sabpaisa.in/SabPaisa/sabPaisaInit?v=1
#   Production     : https://securepay.sabpaisa.in/SabPaisa/sabPaisaInit?v=1
SABPAISA_GATEWAY_URL=https://stage-securepay.sabpaisa.in/SabPaisa/sabPaisaInit?v=1

# Public base URL of THIS app, used to build the callback URL that
# SabPaisa redirects back to after payment (e.g. http://localhost:3000).
NEXT_PUBLIC_BASE_URL=http://localhost:3000
